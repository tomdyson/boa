#!/usr/bin/env node
"use strict";
// boa — small web apps on your own Cloudflare account. One file, no packages.
//
// Settings and secrets live in ~/.config/boa/ (readable only by you). This file never prints them.
// --local sends any command to a Worker running on this computer (`boa dev`) instead of the real one.

const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const http = require("node:http");
const https = require("node:https");
const crypto = require("node:crypto");
const readline = require("node:readline");
const { spawnSync } = require("node:child_process");

const REPO = path.resolve(__dirname, "..");
const WORKER = path.join(REPO, "worker");
const CONFIG_DIR = process.env.BOA_CONFIG_DIR || path.join(os.homedir(), ".config", "boa");
const CONFIG = path.join(CONFIG_DIR, "config.json");
const PASSWORDS = path.join(CONFIG_DIR, "passwords.json");
const LOCAL_PORT = Number(process.env.BOA_LOCAL_PORT) || 8798;
const LOCAL_BASE = `http://127.0.0.1:${LOCAL_PORT}`;
// Pinned, so everyone runs the same tools. Change them here and nowhere else.
const WRANGLER = "wrangler@4.166.0";
const TAILWIND = "@tailwindcss/cli@4.3.5";
const VERSION = (fs.readFileSync(path.join(WORKER, "src", "version.js"), "utf8").match(/VERSION = "([^"]+)"/) || [])[1] || "?";
const USER_AGENT = `boa-cli/${VERSION}`;
const PIECE_BYTES = 1024 * 1024;
const MAX_FILE_BYTES = 25 * 1024 * 1024;
const IMAGE_WARN_BYTES = 1_500_000;
const SKIP_FILES = new Set(["input.css", ".DS_Store", "Thumbs.db"]);
const SKIP_DIRS = new Set(["node_modules", "exports"]);
const RESERVED = new Set(["boa", "boa-exports", "boa-backups"]);
const TYPES = {
  ".html": "text/html", ".css": "text/css", ".js": "text/javascript", ".mjs": "text/javascript", ".json": "application/json",
  ".csv": "text/csv", ".txt": "text/plain", ".md": "text/markdown", ".xml": "application/xml", ".svg": "image/svg+xml",
  ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp", ".avif": "image/avif",
  ".ico": "image/x-icon", ".pdf": "application/pdf", ".woff": "font/woff", ".woff2": "font/woff2", ".ttf": "font/ttf", ".otf": "font/otf",
  ".mp3": "audio/mpeg", ".m4a": "audio/mp4", ".wav": "audio/wav", ".mp4": "video/mp4", ".webm": "video/webm",
  ".webmanifest": "application/manifest+json",
};
const TEXT_TYPES = /^(text\/|application\/(json|xml|manifest\+json)|image\/svg\+xml)/;

