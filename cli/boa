// name: [usage, one-line help, function, {flags that take a value}, {flags that don't}, needs a Worker?]
const COMMANDS = {
  new: ["<app> --title T [--template checklist|questionnaire|signup] [--open] [--private] [--limit name=places]... [--days N] [--password P]", "create an app (a password is made up unless it's open)", cmdNew, ["title", "password", "days", "template"], ["open", "private"], true, ["limit"]],
  settings: ["<app> [--title T] [--private|--shared] [--open] [--limit name=places]... [--remove-limit name]... [--closes DATE|--no-closing-date]", "show or change an app's settings", cmdSettings, ["title", "closes"], ["private", "shared", "open", "no-closing-date"], true, ["limit", "remove-limit"]],
  push: ["<app> [folder] [--no-css]", "build the page's styles and publish the folder's files", cmdPush, [], ["no-css"], true],
  link: ["<app> [--as NAME] [--minutes M] [--visitor ID]", "a one-time sign-in link, for previews or instead of a password", cmdLink, ["as", "minutes", "visitor"], [], true],
  data: ["<app> [--history] [--csv [--answers]] [--json]", "show the answers and bookings: who, what, when", cmdData, [], ["history", "json", "csv", "answers"], true],
  owner: ["[app] [--signout] [--minutes M]", "a one-time link to an app's owner page; --signout signs every device out", cmdOwner, ["minutes"], ["signout"], true],
  unbook: ["<app> <booking number>", "remove someone's booking (the numbers are in `boa data`)", cmdUnbook, [], [], true],
  ls: ["", "list the apps", cmdLs, [], [], true],
  info: ["<app>", "an app's address, password and status", cmdInfo, [], [], true],
  set: ["<app> <key> <value> [--as NAME] [--visitor ID]", "write an answer as the owner (works when closed)", cmdSet, ["as", "visitor"], [], true],
  merge: ["<app> <from> <into>", "private apps: one person on two browsers becomes one visitor", cmdMerge, [], [], true],
  private: ["<app> [--off]", "give each visitor their own answers, seen only by them and you", cmdPrivate, [], ["off"], true],
  open: ["<app>", "drop the password: anyone with the address can read and answer", cmdOpen, [], [], true],
  password: ["<app> [--password P]", "set a new password (signs everyone out; ends open access)", cmdPassword, ["password"], [], true],
  close: ["<app>", "make an app read-only", cmdClose, [], [], true],
  reopen: ["<app> [--days N]", "make a closed app writable again", cmdReopen, ["days"], [], true],
  export: ["<app>", "save the answers and history to a file in boa-exports", cmdExport, [], [], true],
  reset: ["<app> [--yes]", "clear all answers and history (saves a copy first)", cmdReset, [], ["yes"], true],
  rm: ["<app> [--yes]", "delete an app for good (saves its answers first)", cmdRm, [], ["yes"], true],
  home: ["[app] [--none]", "choose the app that the bare address leads to", cmdHome, [], ["none"], true],
  setup: ["[--subdomain NAME] [--domain apps.example.com] [--account ID] [--apps-dir DIR] [--from backup.zip]", "set boa up on this Mac (safe to run again)", cmdSetup, ["subdomain", "domain", "account", "apps-dir", "from"], ["verbose", "force"], false],
  doctor: ["", "look for problems and say how to fix them", cmdDoctor, [], [], false],
  check: ["[--verbose]", "test everything end to end with throwaway apps (half a minute)", cmdCheck, [], ["verbose"], true],
  update: ["[--redeploy]", "fetch the newest boa, put it on the internet and check it", cmdUpdate, [], ["redeploy"], false],
  backup: ["[folder]", "save one zip of settings, page files and answers (default: Documents)", cmdBackup, [], [], true],
  deploy: ["", "put this folder's version of the Worker on the internet", cmdDeploy, [], [], false],
  dev: ["", `run a practice copy of boa on this computer (port ${LOCAL_PORT}); use it with --local`, cmdDev, [], [], false],
};

function usage() {
  const rows = Object.entries(COMMANDS).map(([name, [args, help]]) => [`  boa ${name} ${args}`.trimEnd(), help]);
  const w = Math.min(46, Math.max(...rows.map((r) => r[0].length)));
  return `boa ${VERSION}: small web apps on your own Cloudflare account.\n\n` +
    rows.map(([l, h]) => (l.length > w ? `${l}\n${" ".repeat(w + 2)}${h}` : `${l.padEnd(w + 2)}${h}`)).join("\n") +
    `\n\nAdd --local to any command to use the practice copy started by \`boa dev\`.`;
}

function parseArgs(argv, values, bools, multi = []) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (!arg.startsWith("--") || arg === "--") {
      out._.push(arg);
      continue;
    }
    const [name, inline] = arg.slice(2).split(/=(.*)/s);
    if (bools.includes(name)) out[name] = true;
    else if (values.includes(name) || multi.includes(name)) {
      const v = inline !== undefined ? inline : argv[++i];
      if (v === undefined) die(`--${name} needs a value`);
      if (multi.includes(name)) (out[name] ||= []).push(v);
      else out[name] = v;
    } else die(`unknown option --${name}`);
  }
  return out;
}

async function main(argv) {
  const local = argv.includes("--local");
  argv = argv.filter((x) => x !== "--local");
  const name = argv[0];
  if (!name || name === "help" || name === "--help" || name === "-h") return console.log(usage());
  if (name === "--version" || name === "version") return console.log(VERSION);
  const cmd = COMMANDS[name];
  if (!cmd) die(`there is no "${name}" command. Run \`boa help\` for the list.`);
  const [args, help, fn, values, bools, needsWorker, multi] = cmd;
  if (argv.includes("--help")) return console.log(`boa ${name} ${args}\n  ${help}`);
  const a = parseArgs(argv.slice(1), values, bools, multi);
  a.local = local;
  if (args.startsWith("<app>") || (args.startsWith("[app]") && a._[0])) {
    if (!a._[0]) die(`usage: boa ${name} ${args}`);
    if (!/^[a-z0-9][a-z0-9-]{1,40}$/.test(a._[0])) die(`"${a._[0]}" can't be an app's name: use lowercase letters, digits and hyphens (2 to 41 characters)`);
  }
  await fn(needsWorker ? new Client(local) : null, a);
}

module.exports = { request, pinned, readEnvFile, loadConfig, REPO, WORKER, LOCAL_BASE, VERSION };

if (require.main === module) {
  main(process.argv.slice(2)).catch((e) => {
    if (!(e instanceof Stop)) throw e;
    console.error(`boa: ${e.message}`);
    process.exitCode = 1;
  });
}
