class Stop extends Error {}
function die(msg) {
  throw new Stop(msg);
}

// --- settings on this computer ------------------------------------------------------------------

function readJson(file, fallback) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return fallback;
  }
}

// Everything in the settings folder is private: the folder is 700, each file 600.
function writePrivate(file, text) {
  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
  fs.writeFileSync(file, text, { mode: 0o600 });
  fs.chmodSync(file, 0o600);
}

const loadConfig = () => readJson(CONFIG, {});
const saveConfig = (cfg) => writePrivate(CONFIG, JSON.stringify(cfg, null, 2) + "\n");

function readEnvFile(file) {
  const out = {};
  if (!fs.existsSync(file)) return out;
  for (const line of fs.readFileSync(file, "utf8").split("\n")) {
    const m = line.match(/^\s*([A-Z0-9_]+)\s*=\s*(.*?)\s*$/);
    if (m) out[m[1]] = m[2].replace(/^["']|["']$/g, "");
  }
  return out;
}

// Where apps' page files live: the folder that holds the boa folder (~/Apps), unless setup was told otherwise.
const appsDir = () => process.env.BOA_APPS_DIR || loadConfig().apps_dir || path.dirname(REPO);
const exportsDir = () => path.join(appsDir(), "boa-exports");

function passphrase() {
  const word = () => WORDS[crypto.randomInt(WORDS.length)];
  return `${word()}-${word()}-${word()}-${crypto.randomInt(10, 100)}`;
}

// Passwords are remembered by app name, so they survive a move to a new address. The practice
// copy's are kept apart from the real ones.
const pwKey = (c, slug) => (c.local ? `local:${slug}` : slug);
function savePassword(c, slug, password) {
  const data = readJson(PASSWORDS, {});
  if (password === null) delete data[pwKey(c, slug)];
  else data[pwKey(c, slug)] = password;
  writePrivate(PASSWORDS, JSON.stringify(data, null, 2) + "\n");
}

// 20261120-140502, in this computer's own time: for file names.
function stampNow() {
  const d = new Date();
  const p = (n) => String(n).padStart(2, "0");
  return `${d.getFullYear()}${p(d.getMonth() + 1)}${p(d.getDate())}-${p(d.getHours())}${p(d.getMinutes())}${p(d.getSeconds())}`;
}

function when(iso) {
  if (!iso) return "—";
  const d = new Date(iso);
  const month = d.toLocaleString("en-GB", { month: "short" });
  return `${d.getDate()} ${month} ${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
}

// --- talking to the Worker ----------------------------------------------------------------------

// If this computer can't find the address (a router remembering that it didn't exist a minute ago,
// before the Worker was first put online), look it up through Cloudflare's DNS and use that.
const pinned = {};
async function pinAddress(host) {
  try {
    const r = await fetch(`https://cloudflare-dns.com/dns-query?name=${encodeURIComponent(host)}&type=A`, { headers: { Accept: "application/dns-json" } });
    const ip = ((await r.json()).Answer || []).find((a) => a.type === 1)?.data;
    if (ip) pinned[host] = ip;
    return Boolean(ip);
  } catch {
    return false;
  }
}

function request(base, method, pathname, { headers = {}, body = null, timeout = 120000 } = {}) {
  const u = new URL(base);
  const secure = u.protocol === "https:";
  const send = () =>
    new Promise((resolve, reject) => {
      const opts = { method, host: u.hostname, port: u.port || (secure ? 443 : 80), path: pathname, timeout, headers: { "User-Agent": USER_AGENT, ...headers } };
      const ip = pinned[u.hostname];
      if (ip) opts.lookup = (_h, o, cb) => (o && o.all ? cb(null, [{ address: ip, family: 4 }]) : cb(null, ip, 4));
      if (body !== null) opts.headers["Content-Length"] = Buffer.byteLength(body);
      const req = (secure ? https : http).request(opts, (res) => {
        const chunks = [];
        res.on("data", (c) => chunks.push(c));
        res.on("end", () => resolve({ status: res.statusCode, headers: res.headers, body: Buffer.concat(chunks) }));
      });
      req.on("timeout", () => req.destroy(new Error("no answer in time")));
      req.on("error", reject);
      req.end(body === null ? undefined : body);
    });
  return send().catch(async (e) => {
    const isLocal = ["127.0.0.1", "localhost"].includes(u.hostname);
    if (e.code === "ENOTFOUND" && !isLocal && !pinned[u.hostname] && (await pinAddress(u.hostname))) return send();
    throw e;
  });
}

class Client {
  constructor(local) {
    this.local = local;
    if (local) {
      this.base = LOCAL_BASE;
      this.token = readEnvFile(path.join(WORKER, ".dev.vars")).ADMIN_TOKEN || die("the local Worker has never been started: run `boa dev` first");
    } else {
      const cfg = loadConfig();
      this.base = (process.env.BOA_BASE_URL || cfg.base_url || "").replace(/\/+$/, "") || die("boa isn't set up on this computer yet: run `boa setup`");
      this.token = process.env.BOA_ADMIN_TOKEN || cfg.admin_token || die("boa's settings are incomplete: run `boa setup`");
    }
  }

  // Admin API call. `json` is sent as JSON; `data` (a Buffer) is sent as it is.
  async call(method, pathname, { json, data = null, headers = {}, missingOk = false } = {}) {
    const h = { Authorization: `Bearer ${this.token}`, ...headers };
    let body = data;
    if (json !== undefined) {
      body = Buffer.from(JSON.stringify(json));
      h["Content-Type"] = "application/json";
    }
    let res;
    try {
      res = await request(this.base, method, `/_admin${pathname}`, { headers: h, body });
    } catch (e) {
      die(`can't reach ${this.base} (${e.code || e.message})${this.local ? ": is `boa dev` running?" : ". Check the internet connection, then try `boa doctor`."}`);
    }
    const text = res.body.toString("utf8");
    if (res.status >= 200 && res.status < 300) return text ? JSON.parse(text) : null;
    if (missingOk && res.status === 404) return null;
    let detail = text;
    try {
      detail = JSON.parse(text).error || text;
    } catch {}
    if (res.status === 401) die("the Worker refused boa's key. If boa was set up again elsewhere, restore the newest backup here; `boa doctor` says more.");
    die(`${method} ${pathname} failed (${res.status}): ${String(detail).slice(0, 300)}`);
  }

  async app(slug) {
    return (await this.call("GET", `/apps/${slug}`, { missingOk: true })) || die(`there is no app called "${slug}" (\`boa ls\` lists them)`);
  }
}

const q = (s) => s.split("/").map(encodeURIComponent).join("/");

// --- commands -----------------------------------------------------------------------------------

function closingDate(days) {
  const d = new Date(Date.now() + days * 864e5);
  return `${d.toISOString().slice(0, 10)}T23:59:59Z`;
}

// --limit tuesday-yoga=12 (as many as needed) -> {"tuesday-yoga": 12}
function parseLimits(list = []) {
  const out = {};
  for (const item of list) {
    const m = String(item).match(/^([A-Za-z0-9][A-Za-z0-9_.-]{0,59})=(\d+)$/);
    if (!m) die(`"${item}" isn't a limit: write it as name=places, for example tuesday-yoga=12`);
    out[m[1]] = Number(m[2]);
  }
  return out;
}

const limitLines = (limits) => Object.entries(limits || {}).map(([name, l]) => `${name}: ${l.taken} of ${l.places} taken, ${l.left} left`);

async function cmdNew(c, a) {
  const slug = a._[0];
  if (RESERVED.has(slug)) die(`"${slug}" is a name boa keeps for itself: pick another`);
  if (await c.call("GET", `/apps/${slug}`, { missingOk: true })) die(`${slug} already exists: \`boa push\` updates it, \`boa password\` changes its password`);
  if (!a.title) die("give the app a title: --title \"Dinner dates\"");
  const password = a.password || passphrase();
  const expires = a.days ? closingDate(Number(a.days)) : null;
  const limits = parseLimits(a.limit);
  const r = await c.call("PUT", `/apps/${slug}`, { json: { title: a.title, password, expires_at: expires, open: Boolean(a.open), private: Boolean(a.private), limits } });
  savePassword(c, slug, password);
  const access = a.open ? "open: no password, anyone with the address can use it" : `password: ${password}`;
  const answers = a.private ? "private: each visitor sees only their own" : "shared: everyone sees everyone's";
  console.log(`Created ${c.base}/${slug}/\n  title:    ${r.title}\n  access:   ${access}\n  answers:  ${answers}\n  closes:   ${expires ? `${expires.slice(0, 10)} (read-only after)` : "when you close it"}`);
  for (const line of limitLines(r.limits)) console.log(`  places:   ${line}`);
  if (a.template) {
    const src = path.join(REPO, "templates", a.template);
    const dest = path.join(appsDir(), slug);
    if (!fs.existsSync(path.join(src, "index.html"))) console.log(`\nNo template called "${a.template}": there are ${fs.readdirSync(path.join(REPO, "templates")).join(", ")}.`);
    else if (fs.existsSync(dest)) console.log(`\n${dest} already exists, so the template wasn't copied over it.`);
    else {
      fs.cpSync(src, dest, { recursive: true });
      console.log(`\nStarting page (${a.template}) copied to ${dest}`);
    }
  }
  console.log(`\nNext: write the page in ${path.join(appsDir(), slug)}, \`boa push ${slug}\`, check it with \`boa link ${slug}\`, then share ${a.open ? "the address" : "the address and password"}.`);
}

// Tailwind runs through npx at a pinned version. Its stylesheet can't be found by name from an
// app's folder, so find where npx keeps it and import it by its full path.
function tailwind() {
  const r = spawnSync("npx", ["-y", "-p", TAILWIND, "-c", "command -v tailwindcss"], { encoding: "utf8" });
  const bin = (r.stdout || "").trim().split("\n").pop();
  if (r.status !== 0 || !bin || !fs.existsSync(bin)) die(`couldn't get the tool that builds page styles (needs the internet the first time):\n${(r.stderr || "").trim().slice(-400)}`);
  const sheet = path.join(path.dirname(path.dirname(bin)), "tailwindcss", "index.css");
  if (!fs.existsSync(sheet)) die("the page-style tool is missing a file: try again, or run `boa doctor`");
  return { bin, sheet };
}

function buildCss(dir) {
  const { bin, sheet } = tailwind();
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), "boa-css-"));
  try {
    // source(none): Tailwind would otherwise scan the whole working folder, not just this app.
    let input = `@import ${JSON.stringify(sheet)} source(none);\n@source ${JSON.stringify(dir)};\n`;
    const custom = path.join(dir, "input.css");
    if (fs.existsSync(custom)) input += fs.readFileSync(custom, "utf8").replace(/@import\s+["']tailwindcss["'][^;]*;/g, "").replace(/@source\s+["']\.\/?["']\s*;/g, "");
    const src = path.join(tmp, "input.css");
    fs.writeFileSync(src, input);
    const r = spawnSync(bin, ["-i", src, "-o", path.join(dir, "app.css"), "--minify"], { encoding: "utf8" });
    if (r.status !== 0) die(`building the page's styles failed:\n${(r.stderr || "").trim().slice(-800)}`);
  } finally {
    fs.rmSync(tmp, { recursive: true, force: true });
  }
  console.log(`  built app.css (${(fs.statSync(path.join(dir, "app.css")).size / 1024).toFixed(1)} KB)`);
}

function walk(dir, rel = "") {
  const out = [];
  for (const name of fs.readdirSync(path.join(dir, rel)).sort()) {
    if (name.startsWith(".") || name.startsWith("_") || SKIP_FILES.has(name)) continue;
    const r = rel ? `${rel}/${name}` : name;
    const st = fs.statSync(path.join(dir, r));
    if (st.isDirectory()) {
      if (!SKIP_DIRS.has(name)) out.push(...walk(dir, r));
    } else if (st.isFile()) out.push(r);
  }
  return out;
}

function contentType(file) {
  const t = TYPES[path.extname(file).toLowerCase()] || "application/octet-stream";
  return TEXT_TYPES.test(t) ? `${t}; charset=utf-8` : t;
}

function appFolder(slug, given) {
  const dir = path.resolve(given ? given.replace(/^~(?=\/|$)/, os.homedir()) : path.join(appsDir(), slug));
  if (!fs.existsSync(path.join(dir, "index.html"))) die(`${dir} has no index.html`);
  return dir;
}

async function cmdPush(c, a) {
  const slug = a._[0];
  const dir = appFolder(slug, a._[1]);
  await c.app(slug);
  console.log(`Publishing ${dir} to ${slug}`);
  const htmls = walk(dir).filter((f) => f.endsWith(".html")).map((f) => fs.readFileSync(path.join(dir, f), "utf8"));
  if (!a["no-css"] && htmls.some((h) => h.includes("app.css"))) buildCss(dir);
  // Pages should load nothing from other websites: Alpine.js and the fonts come from boa itself.
  const outside = new Set();
  for (const h of htmls) for (const m of h.matchAll(/<(?:script|link)\b[^>]*?\b(?:src|href)=["'](https?:\/\/[^"'/]+)/gi)) outside.add(m[1]);
  if (outside.size) console.log(`  warning: the page loads files from ${[...outside].join(", ")}. Use /_boa/alpine.js and /_boa/fonts.css instead, so it depends on nobody else.`);

  // A sign-up page keeps its numbers of places beside it, in limits.json: {"tue-12-jan": 12, …}.
  const limitsFile = path.join(dir, "limits.json");
  if (fs.existsSync(limitsFile)) {
    const limits = readJson(limitsFile, null);
    if (!limits || typeof limits !== "object" || Array.isArray(limits)) die("limits.json should look like {\"tue-12-jan\": 12}: a name and a number of places for each thing people can book");
    const r = await c.call("PUT", `/apps/${slug}`, { json: { limits } });
    for (const line of limitLines(r.limits)) console.log(`  places: ${line}`);
  }

  const files = walk(dir).filter((f) => f !== "limits.json");
  const remote = Object.fromEntries((await c.call("GET", `/apps/${slug}/files`)).map((f) => [f.path, f.etag]));
  let uploaded = 0;
  for (const rel of files) {
    const body = fs.readFileSync(path.join(dir, rel));
    const md5 = crypto.createHash("md5").update(body).digest("hex");
    if (remote[rel] === md5) continue;
    if (body.length > MAX_FILE_BYTES) die(`${rel} is ${(body.length / 1e6).toFixed(0)} MB: the most boa can hold in one file is 25 MB`);
    const parts = Math.max(1, Math.ceil(body.length / PIECE_BYTES));
    const upload = crypto.randomUUID();
    for (let i = 0; i < parts; i++) {
      await c.call("PUT", `/apps/${slug}/files/${q(rel)}`, {
        data: body.subarray(i * PIECE_BYTES, (i + 1) * PIECE_BYTES),
        headers: { "Content-Type": contentType(rel), "X-Boa-Etag": md5, "X-Boa-Upload": upload, "X-Boa-Part": String(i), "X-Boa-Parts": String(parts) },
      });
    }
    uploaded++;
    console.log(`  up   ${rel} (${(body.length / 1024).toFixed(0)} KB)`);
    if (/\.(png|jpe?g)$/i.test(rel) && body.length > IMAGE_WARN_BYTES) {
      console.log(`       warning: a ${(body.length / 1e6).toFixed(1)} MB image is slow on a phone. \`sips -Z 1600 "${path.join(dir, rel)}"\` shrinks it to 1600 pixels.`);
    }
  }
  let removed = 0;
  for (const rel of Object.keys(remote).filter((r) => !files.includes(r)).sort()) {
    await c.call("DELETE", `/apps/${slug}/files/${q(rel)}`);
    removed++;
    console.log(`  del  ${rel}`);
  }
  console.log(`Done: ${uploaded} uploaded, ${removed} removed, ${files.length - uploaded} unchanged.\n${c.base}/${slug}/`);
}

function fmtValue(v) {
  if (typeof v === "string") return !v.includes("\n") && v.length <= 100 ? JSON.stringify(v) : "\n" + v.replace(/^/gm, "      ");
  if (Array.isArray(v) && v.every((x) => typeof x === "string")) return `[${v.join(", ")}]`;
  return JSON.stringify(v);
}

const groupBy = (rows, key) => rows.reduce((g, r) => ((g[r[key]] ||= []).push(r), g), {});
const plural = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;

function statusLine(i) {
  return i.closed ? "closed" : i.expires_at ? `open until ${i.expires_at.slice(0, 10)}` : "open";
}

async function cmdData(c, a) {
  const slug = a._[0];
  await c.app(slug);
  const x = await c.call("GET", `/apps/${slug}/export`);
  if (a.json) return console.log(JSON.stringify(x, null, 2));
  if (a.csv) return console.log(a.answers || !Object.keys(x.info.limits || {}).length ? answersCsv(x) : bookingsCsv(x));
  const i = x.info;
  console.log(`${i.title} — ${c.base}/${slug}/ (${statusLine(i)})`);
  const priv = x.private_state || [];
  const visits = Object.fromEntries((x.visits || []).map((v) => [v.visitor, v]));
  if (i.private) {
    console.log(`Private answers: ${plural(Object.keys(visits).length, "visitor")}, ${i.visitors} with answers, ${plural(i.answers, "answer")}, last ${when(i.last_at)}, ${plural(x.history.length, "change")} in history\n`);
  } else {
    console.log(`${plural(i.answers, "answer")}, last ${when(i.last_at)}, ${plural(x.history.length, "change")} in history\n`);
  }
  if (x.state.length && priv.length) console.log("Shared answers:");
  for (const r of x.state) console.log(`  ${r.key}: ${fmtValue(r.value)}\n      — ${r.author}, ${when(r.at)}`);
  const groups = groupBy(priv, "visitor");
  // Everyone who has opened the page, then anyone with answers but no recorded visit (admin writes).
  for (const v of [...Object.keys(visits), ...Object.keys(groups).filter((g) => !visits[g])]) {
    const rows = groups[v] || [];
    const latest = rows.reduce((m, r) => (!m || r.at > m.at ? r : m), null);
    const vi = visits[v];
    const name = vi?.name || latest?.author || "(no name yet)";
    const bits = [name, `visitor ${v.slice(0, 8)}`];
    if (vi) bits.push(vi.device || "?", `${plural(vi.visits, "visit")}, first ${when(vi.first_at)}, last ${when(vi.last_at)}`);
    bits.push(plural(rows.length, "answer") + (latest ? `, last ${when(latest.at)}` : ""));
    console.log("\n" + bits.join(" · "));
    for (const r of rows) console.log(`  ${r.key}: ${fmtValue(r.value)}${r.author !== name ? ` — ${r.author}` : ""}`);
  }
  const booked = groupBy(x.bookings || [], "limit");
  for (const [name, l] of Object.entries(i.limits || {})) {
    console.log(`\n${name}: ${l.taken} of ${l.places} places taken, ${l.left} left`);
    for (const b of booked[name] || []) {
      console.log(`  #${b.id}  ${b.name}${b.email ? ` <${b.email}>` : ""}, booked ${when(b.at)}${b.note ? `\n      note: ${fmtValue(b.note)}` : ""}`);
    }
  }
  if (a.history) {
    console.log("\nHistory (oldest first):");
    for (const h of x.history) console.log(`  ${when(h.at)}  ${h.visitor ? `${h.author} [${h.visitor.slice(0, 8)}]` : h.author}: ${h.key} = ${fmtValue(h.value)}`);
  }
}

// For a spreadsheet. A cell starting with = + - or @ would be run as a formula, so it gets a ' in front.
function csv(rows) {
  const cell = (v) => {
    let s = v === null || v === undefined ? "" : typeof v === "string" ? v : JSON.stringify(v);
    if (/^[=+\-@\t\r]/.test(s)) s = "'" + s;
    return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
  };
  return rows.map((r) => r.map(cell).join(",")).join("\r\n");
}

const bookingsCsv = (x) =>
  csv([["what", "name", "email", "note", "booked at", "booking number"], ...(x.bookings || []).map((b) => [b.limit, b.name, b.email, b.note, b.at, String(b.id)])]);

function answersCsv(x) {
  if (!x.info.private) return csv([["question", "answer", "who", "when"], ...x.state.map((r) => [r.key, r.value, r.author, r.at])]);
  const names = Object.fromEntries((x.visits || []).map((v) => [v.visitor, v.name]));
  return csv([["visitor", "name", "question", "answer", "when"], ...(x.private_state || []).map((r) => [r.visitor.slice(0, 8), names[r.visitor] || r.author, r.key, r.value, r.at])]);
}

async function resolveVisitor(c, slug, prefix) {
  const x = await c.call("GET", `/apps/${slug}/export`);
  const ids = new Set([...(x.private_state || []).map((r) => r.visitor), ...(x.visits || []).map((v) => v.visitor)]);
  const hits = [...ids].filter((v) => v.startsWith(String(prefix).toLowerCase())).sort();
  if (!hits.length) die(`no visitor on ${slug} starts with "${prefix}" (\`boa data ${slug}\` lists them)`);
  if (hits.length > 1) die(`"${prefix}" matches ${hits.length} visitors: give more of the id`);
  return hits[0];
}

function table(head, rows) {
  const widths = head.map((_, i) => Math.max(...[head, ...rows].map((r) => String(r[i]).length)));
  for (const r of [head, ...rows]) console.log(r.map((s, i) => String(s).padEnd(widths[i])).join("  ").trimEnd());
}

async function cmdLs(c) {
